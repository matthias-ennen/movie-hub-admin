{
  "functions": [{ "source": "functions", "codebase": "movie-hub-admin" }],
  "hosting": {
    "target": "admin",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
